{
  "name": "zocial-social-platform",
  "private": true,
  "version": "1.0.0",
  "description": "A small social platform with profiles, posts, image uploads, comments and reactions.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx server/seed-cli.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.15.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@types/multer": "^2.0.0"
  }
}
