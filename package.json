{
  "name": "zocial-social-platform",
  "private": true,
  "version": "1.0.0",
  "description": "A small social platform with profiles, posts, image uploads, comments and reactions.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && npm run build:api",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx server/seed-cli.ts",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.mjs --banner:js=\"// Generated by npm run build:api from server/vercel.ts. Do not edit.\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tanstack/react-query": "^5.108.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.15.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
